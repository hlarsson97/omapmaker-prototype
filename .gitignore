# Local credentials must never be committed.
.env
.env.*
*.token
*.cred
*.part

# Python and local server environment.
.venv/
__pycache__/
*.py[cod]
*.log

# Downloaded Lantmäteriet data and generated caches can be large and may have
# separate distribution terms. They remain on the server only.
data/lantmateriet/
data/contour-cache/
data/omapmaker.sqlite3*
data/backups/

# Local copies of published map specifications. Keep official source links in
# SOURCES.md instead of redistributing the PDF files through this repository.
references/specifications/*.pdf

